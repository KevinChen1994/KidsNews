# Uppercase is the current form. Lowercase still works, including the historical accecc typo.
VOLCENGINE_APP_ID=
VOLCENGINE_ACCECC_TOKEN=
# Secret key is not needed by this TTS endpoint.
# Alternatively use the new console API key:
VOLCENGINE_API_KEY=
ELEVENLABS_API_KEY=

# Baidu OAuth application credentials; never commit actual values.
BAIDU_NETDISK_APPID=
BAIDU_NETDISK_APPKEY=
BAIDU_NETDISK_SECRETKEY=
BAIDU_NETDISK_SIGNKEY=
# Account tokens are saved by scripts/baidu_auth.py after user authorization.
BAIDU_NETDISK_ACCESS_TOKEN=
BAIDU_NETDISK_REFRESH_TOKEN=
BAIDU_NETDISK_TOKEN_EXPIRES_AT=
