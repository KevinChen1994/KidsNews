.env
.env.*
!.env.example
__pycache__/
*.pyc
*.part
*.lock
.DS_Store

# Personal settings and local source material
/config/local.json
/config/local.*.json
!/config/local.example.json
/private/

# Episodes, transcripts, delivery records, auditions and daily state
/episodes/
/delivery/
/samples/
/state/

# Personal audio stays ignored; reusable instrumental inventory is tracked
*.mp3
*.wav
*.m4a
*.flac
!/assets/music/*.mp3

# Provider sidecars stay local (keep catalog and batch manifests)
/assets/music/*.json
!/assets/music/catalog.json
!/assets/music/library-build-*.json
!/assets/music/library-expansion-*.json
/assets/music/*.results.json

# Local validation output
/docs/audio-validation.json
/docs/mix-loudness.json
